<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Directory.Build.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PlugHub.SettingsApp</AssemblyName>
    <RootNamespace>PlugHub.SettingsApp</RootNamespace>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlugHub.Framework\PlugHub.Framework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\PlugHub.Revit2020\FrameworkSettingsWindow.cs" Link="SharedSettings\FrameworkSettingsWindow.cs" />
    <Compile Include="..\PlugHub.Revit2020\FrameworkStatusWindow.cs" Link="SharedSettings\FrameworkStatusWindow.cs" />
    <Compile Include="..\PlugHub.Revit2020\RevitUiTheme.cs" Link="SharedSettings\RevitUiTheme.cs" />
    <Compile Include="..\PlugHub.Revit2020\DefaultRibbonIconProvider.cs" Link="SharedSettings\DefaultRibbonIconProvider.cs" />
    <Compile Include="..\PlugHub.Revit2020\RevitWindowOwner.cs" Link="SharedSettings\RevitWindowOwner.cs" />
    <Compile Include="..\PlugHub.Revit2020\Settings\**\*.cs" Link="SharedSettings\Settings\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
