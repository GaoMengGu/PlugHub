<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PlugHub.Revit2020</AssemblyName>
    <RootNamespace>PlugHub.Revit2020</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <StagePlugHubOutput Condition="'$(StagePlugHubOutput)' == ''">true</StagePlugHubOutput>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiReferenceMode)' == 'Installed'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RevitApiReferenceMode)' == 'NuGet'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="$(RevitApiNuGetVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlugHub.Contracts\PlugHub.Contracts.csproj" />
    <ProjectReference Include="..\PlugHub.Framework\PlugHub.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\manifests\PlugHub.addin.template">
      <Link>PlugHub.addin.template</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Icons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PlugHubSvgIcon Include="Resources\Icons\*.svg" />
  </ItemGroup>

  <Target Name="EnsureRevitApiReferenceMode" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RevitApiReferenceMode)' != 'Installed' and '$(RevitApiReferenceMode)' != 'NuGet'" Text="Unsupported RevitApiReferenceMode '$(RevitApiReferenceMode)'. Use Installed for local Revit API DLLs or NuGet for CI compile references." />
    <Error Condition="'$(RevitApiReferenceMode)' == 'NuGet' and '$(RevitApiNuGetVersion)' == ''" Text="RevitApiNuGetVersion is required when RevitApiReferenceMode=NuGet." />
  </Target>

  <Target Name="EnsureInstalledRevitApiReferences" BeforeTargets="ResolveReferences" Condition="'$(RevitApiReferenceMode)' == 'Installed'">
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')" Text="RevitAPI.dll not found. Pass /p:RevitApiDir=&quot;C:\Program Files\Autodesk\Revit $(RevitVersion)&quot; or build with /p:RevitApiReferenceMode=NuGet for CI compile references." />
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPIUI.dll')" Text="RevitAPIUI.dll not found. Pass /p:RevitApiDir=&quot;C:\Program Files\Autodesk\Revit $(RevitVersion)&quot; or build with /p:RevitApiReferenceMode=NuGet for CI compile references." />
  </Target>

  <Target Name="StagePlugHubOutput" AfterTargets="Build" Condition="'$(StagePlugHubOutput)' == 'true'">
    <MakeDir Directories="$(PlugHubOutputDir)" />
    <MakeDir Directories="$(PlugHubOutputDir)\config" />
    <MakeDir Directories="$(PlugHubOutputDir)\packages" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PlugHubOutputDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PlugHubOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\manifests\PlugHub.addin.template" DestinationFiles="$(PlugHubOutputDir)\PlugHub.addin" />
    <Copy SourceFiles="..\..\config\sources.example.json" DestinationFiles="$(PlugHubOutputDir)\config\sources.json" />
    <Copy SourceFiles="..\..\config\views.example.json" DestinationFiles="$(PlugHubOutputDir)\config\views.json" />
    <Copy SourceFiles="..\..\config\feature-combinations.example.json" DestinationFiles="$(PlugHubOutputDir)\config\feature-combinations.json" />
    <Copy SourceFiles="@(PlugHubSvgIcon)" DestinationFolder="$(PlugHubOutputDir)\Resources\Icons\" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(PlugHubOutputDir)\packages\README.md" Lines="Put installed plugin module folders with modules.json manifests here to let PlugHub discover them during startup." Overwrite="true" />
  </Target>
</Project>
