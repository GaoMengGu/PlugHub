<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Directory.Build.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PlugHub.Revit2020</AssemblyName>
    <RootNamespace>PlugHub.Revit2020</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlugHub.Contracts\PlugHub.Contracts.csproj" />
    <ProjectReference Include="..\PlugHub.Framework\PlugHub.Framework.csproj" />
    <ProjectReference Include="..\PlugHub.BuiltinModule\PlugHub.BuiltinModule.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\manifests\PlugHub.addin.template">
      <Link>PlugHub.addin.template</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\*.example.json">
      <Link>config\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PlugHubModuleFiles Include="..\..\modules\**\*.*" Exclude="..\..\modules\github\**\*.*" />
  </ItemGroup>

  <Target Name="EnsureRevitApiReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')" Text="RevitAPI.dll not found. Pass /p:RevitApiDir=&quot;C:\Program Files\Autodesk\Revit 2020&quot; or copy Revit 2020 API DLLs to that folder." />
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPIUI.dll')" Text="RevitAPIUI.dll not found. Pass /p:RevitApiDir=&quot;C:\Program Files\Autodesk\Revit 2020&quot; or copy Revit 2020 API DLLs to that folder." />
  </Target>

  <Target Name="StagePlugHubOutput" AfterTargets="Build">
    <MakeDir Directories="$(PlugHubOutputDir)" />
    <MakeDir Directories="$(PlugHubOutputDir)\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PlugHubOutputDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PlugHubOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\manifests\PlugHub.addin.template" DestinationFiles="$(PlugHubOutputDir)\PlugHub.addin" />
    <Copy SourceFiles="..\..\config\modules.example.json" DestinationFiles="$(PlugHubOutputDir)\config\modules.json" />
    <Copy SourceFiles="..\..\config\views.example.json" DestinationFiles="$(PlugHubOutputDir)\config\views.json" />
    <Copy SourceFiles="..\..\config\feature-combinations.example.json" DestinationFiles="$(PlugHubOutputDir)\config\feature-combinations.json" />
    <Copy SourceFiles="@(PlugHubModuleFiles)" DestinationFiles="@(PlugHubModuleFiles->'$(PlugHubOutputDir)\modules\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
