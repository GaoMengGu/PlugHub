{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "packageDirectories": {"type": "array", "items": {"type": "string"}},
    "moduleSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["localFolder"]},
          "path": {"type": "string"},
          "repository": {"type": "string"},
          "ref": {"type": "string"},
          "manifestPath": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "visibility", "repository", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "displayName": {"type": "string"},
          "provider": {"enum": ["github", "gitee", "local"]},
          "visibility": {"enum": ["public", "private"]},
          "repository": {"type": "string"},
          "ref": {"type": "string"},
          "manifestPath": {"type": "string"},
          "apiKey": {"type": "string"},
          "encryptedApiKey": {"type": "string"},
          "apiKeyProtection": {"type": "string"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "conflictPolicy": {"type": "object"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "features"],
        "allOf": [{
          "if": { "required": ["autoStart"], "properties": { "autoStart": { "const": true } } },
          "then": {
            "required": ["assembly", "startupType"],
            "properties": {
              "assembly": { "type": "string", "pattern": "\\S" },
              "startupType": { "type": "string", "pattern": "\\S" }
            }
          }
        }],
        "properties": {
          "id": {"type": "string"},
          "assembly": {"type": "string"},
          "autoStart": {"type": "boolean", "default": false},
          "startupType": {"type": "string"},
          "type": {"type": "string"},
          "name": {"type": "string"},
          "displayName": {"type": "string"},
          "description": {"type": "string"},
          "sourceId": {"type": "string"},
          "order": {"type": "integer"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "dependsOn": {"type": "array", "items": {"type": "string"}},
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "category", "group", "order"],
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "displayName": {"type": "string"},
                "description": {"type": "string"},
                "category": {"type": "string"},
                "group": {"type": "string"},
                "tags": {"type": "array", "items": {"type": "string"}},
                "order": {"type": "integer"},
                "buttonSize": {"enum": ["large", "small"]},
                "iconPath": {"type": "string"},
                "commandKey": {"type": "string"},
                "commandAssembly": {"type": "string"},
                "commandType": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
