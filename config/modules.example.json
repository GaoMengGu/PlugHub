      "path": "modules/github/GaoMengGu_PlugHubModules",
      "manifestPath": "plughub.modules.json",
      "enabled": false,
      "autoUpdate": false
    }
  ],
  "conflictPolicy": {
    "duplicateFeatureId": "fail-feature",
    "duplicateModuleId": "fail-module",
    "missingModuleType": "warn"
  },
