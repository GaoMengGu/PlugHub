{
  "schemaVersion": "1.0",
  "packageDirectories": [
    "packages"
  ],
  "moduleSources": [],
  "repositories": [
    {
      "id": "plughub-public-packages",
      "displayName": "PlugHub 公共插件仓库",
      "provider": "github",
      "visibility": "public",
      "repository": "GaoMengGu/PlugHub_Packages",
      "ref": "main",
      "manifestPath": "packages.json",
      "apiKey": "",
      "enabled": true
    },
    {
      "id": "cloud-private-packages",
      "displayName": "私有云端插件仓库",
      "provider": "github",
      "visibility": "private",
      "repository": "your-org/private-plughub-packages",
      "ref": "main",
      "manifestPath": "packages.json",
      "apiKey": "",
      "enabled": false
    },
    {
      "id": "local-folder-packages",
      "displayName": "本地文件夹插件仓库",
      "provider": "local",
      "visibility": "public",
      "repository": "D:/PlugHub/LocalPackages",
      "ref": "main",
      "manifestPath": "packages.json",
      "apiKey": "",
      "enabled": false
    }
  ],
  "conflictPolicy": {
    "duplicateFeatureId": "fail-feature",
    "duplicateModuleId": "fail-module",
    "missingModuleType": "warn"
  },
  "modules": []
}
